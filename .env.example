APP_NAME="Adire Lane MCP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- MCP server ---------------------------------------------------------
# Bearer token required on POST /mcp. Leave empty only on your own machine.
MCP_TOKEN=
# Expose write tools (update_order_status). Set false for a read-only server.
MCP_ALLOW_WRITES=true

# --- LLM for the console's agent (Prism PHP) -----------------------------
# gemini | groq | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model
# LLM_MODEL=

# true = scripted AI replies, no key needed (also automatic when the key is empty)
DEMO_MODE=false
